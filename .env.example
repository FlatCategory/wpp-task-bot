# Ollama (local LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# WhatsApp — JID of the group where audios become tasks
# Send "!ping" in the group and check the logs to find the JID
TASK_GROUP_JID=

# Python — interpreter path (venv or system)
PYTHON_BIN=python3

# Chromium — executable path for puppeteer
CHROMIUM_PATH=/usr/bin/chromium

# External APIs (optional — !gif and !img won't work without them)
SERPAPI_KEY=
KLIPY_KEY=
